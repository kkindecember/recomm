.cache/
.runtime/
check.sh

# GRAM is vendored in recomm. Keep any upstream Git metadata backup local only.
.gram_upstream_git_backup/
GRAM/.git/
GRAM/rec_datasets/
GRAM/assets/

# Runtime model outputs and predictions can be hundreds of MiB.
GRAM/log/
GRAM/preds/
*.pt
*.pth
*.ckpt

# Python/editor caches.
**/__pycache__/
.pytest_cache/
*.py[cod]
.idea/
.vscode/

# Experiment runtime state and high-frequency telemetry.
experiment/**/*.pid
experiment/**/*_status.json
experiment/**/*_gpu*.csv
experiment/**/*_disk.csv

# Full logs stay on the experiment machine; reports contain the durable summary.
artifacts/**/logs/
artifacts/**/run.log

# High-frequency or user-level experiment outputs stay local. Commit aggregate
# summaries, frozen configs and split manifests instead.
artifacts/**/gpu_telemetry.csv
artifacts/**/status.json
artifacts/**/per_user.csv
artifacts/**/validation_per_user.csv
artifacts/**/candidate_bank.json
artifacts/**/gamma.json
artifacts/**/splits/**/*.txt

# Large reproducible detail dumps. Keep their configs and aggregate summaries.
artifacts/**/predictions/
artifacts/**/candidate_scores.tsv
artifacts/**/feature_table.npz
artifacts/**/beams_w*.tsv
artifacts/**/fresh_beams*.tsv

# Phase-5 long-running CET session state; durable summaries are committed separately.
artifacts/phase5/cet_c2*/run.log
artifacts/phase5/cet_c2*/status.json

# Phase 13 experiment outputs
artifacts/phase13/explore/**/gram_logs/
artifacts/phase13/explore/**/mlp/*.pt
artifacts/phase13/explore/**/gpu_lease.json
artifacts/phase13/explore/**/metrics_cold_warm.json
artifacts/phase13/explore/**/*.jsonl
artifacts/phase13/llm_cache.db
artifacts/phase13/explore/**/mlp/training_history.json
artifacts/phase13/explore/**/mlp/vocab.json
artifacts/phase13/explore/**/training_history.json
artifacts/phase13/explore/**/vocab.json
artifacts/phase13/explore/**/llm_priors_status.json
artifacts/phase13/explore/**/gram_logs/**/config.json
artifacts/phase13/explore/**/*.log

# Phase 14 local model/data payloads and per-example outputs. Keep compact
# configs, provenance, aggregate summaries and synthesis files in Git.
artifacts/phase14/**/*.jsonl
artifacts/phase14/m2/pretrained/
artifacts/phase14/m2/pseudo_cold_audit_toys/
artifacts/phase14/m2/pseudo_cold_screen_toys_pipeline_smoke*/
artifacts/phase14/m2/pseudo_cold_screen_toys_shape_smoke/
artifacts/phase14/controls/same_backbone_verifier_smoke/
artifacts/phase14/diagnostics/oracle_prefix_probe_toys_smoke_gpu0_retry3/

# Phase 15 local data/model payloads and per-event diagnostics. Keep source,
# tests, plans/reports, and compact JSON contracts/summaries in Git.
artifacts/phase15/**/*.jsonl
artifacts/phase15/**/dataset_view*/
artifacts/phase15/**/projected_data/*/user_sequence_train_validation.txt
artifacts/phase15/**/b2_verifier_direct_parity.json
artifacts/phase15/**/trigger_diagnostics.json
artifacts/phase15/**/z_optimization.json
artifacts/phase15/**/layer_probe.json
artifacts/phase15/s2_contract_smoke/toys/b2_verifier_probe_smoke/
artifacts/phase15/s2_contract_smoke/toys/b2_verifier_probe_smoke_attempt2/
artifacts/phase15/s2_contract_smoke/toys/b2_verifier_probe_smoke_attempt3/
artifacts/phase15/s3_toys/admission/item_disjoint_b2_b3/
artifacts/phase15/s3_toys/admission/item_disjoint_b2_b3_attempt2/

# Phase 16 local split rows, training traces, progress, and one-shot guard
# runtime state. Keep frozen source/configs and compact contracts/summaries.
artifacts/phase16/**/*.jsonl
artifacts/phase16/**/progress.json
artifacts/phase16/**/armed.lock
artifacts/phase16/**/preflight.log
artifacts/phase16/**/gpu*_baseline_compute_pids.txt
artifacts/phase16/**/formal_admission_summary.json

# S16-4 formal roots copy the committed source config and immutable-runtime
# manifest for local execution identity. The source configs/protocols and
# compact terminal summaries remain eligible for Git.
artifacts/phase16/s4_toys_standalone/formal/**/config.json
artifacts/phase16/s4_toys_standalone/formal/**/runtime_snapshot_manifest.json

# Stage16 non-promotional occupancy/repeat cycles are local runtime evidence.
# Their formal parent contracts and summaries remain eligible for Git.
artifacts/phase16/s3_genrecedit/inspired_ridge/stability/

# Phase 17 is still being developed by a separate agent. Keep its compact
# contracts/results, status, and attempt ledgers visible, but exclude
# machine-local training payloads, replicated data, and execution logs.
artifacts/phase17/runtime/
artifacts/phase17/**/gram_logs*/
artifacts/phase17/**/predictions/
artifacts/phase17/**/profile_data/
artifacts/phase17/**/shadow_data/
artifacts/phase17/**/*.log
artifacts/phase17/**/*.tsv
artifacts/phase17/**/*.jsonl
artifacts/phase17/**/*.lock
!artifacts/phase17/attempts/*.jsonl

# Run snapshots duplicate the frozen source/configuration recorded by hashes.
# Generated input views can be rebuilt; keep their adjacent manifests visible.
artifacts/phase17/snapshots/
artifacts/phase17/s2r_preflight/data/**/*.txt
artifacts/phase17/**/preflight/data/

# Commit-pinned source manifests are durable; downloaded/extracted third-party
# source trees are reproducible machine-local payloads.
artifacts/phase17/fullport/sources/

# Per-user metric rows are reproducible detail outputs. Keep aggregate
# learning curves, summaries, configs, and canonical result manifests.
artifacts/phase17/**/*_user_metrics.json

# Large item/user-level frozen views are reproducible from the committed
# protocol/config and adjacent compact manifests/summaries.
artifacts/phase17/**/portfolio_config.json
artifacts/phase17/**/transition_teacher*.json
artifacts/phase17/s2r_preflight/sid/
artifacts/phase17/**/*_user_ids.txt

# Phase 13 local resource orchestration and failed-launch diagnostics.
artifacts/phase13/explore/**/.resource_transition_started
artifacts/phase13/explore/**/preexisting_gpu_pids.txt
artifacts/phase13/explore/**/resource_watchdog_status.json
artifacts/phase13/explore/**/test_access.json
artifacts/phase13/explore/**/status.*.json
artifacts/phase13/explore/**/recompute_output.txt
