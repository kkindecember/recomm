.cache/
.runtime/
check.sh

# GRAM is vendored in recomm. Keep any upstream Git metadata backup local only.
.gram_upstream_git_backup/
GRAM/.git/
GRAM/rec_datasets/
GRAM/assets/

# Runtime model outputs and predictions can be hundreds of MiB.
GRAM/log/
GRAM/preds/
*.pt
*.pth
*.ckpt

# Python/editor caches.
**/__pycache__/
.pytest_cache/
*.py[cod]
.idea/
.vscode/

# Experiment runtime state and high-frequency telemetry.
experiment/**/*.pid
experiment/**/*_status.json
experiment/**/*_gpu*.csv
experiment/**/*_disk.csv

# Full logs stay on the experiment machine; reports contain the durable summary.
artifacts/**/logs/
artifacts/**/run.log

# High-frequency or user-level experiment outputs stay local. Commit aggregate
# summaries, frozen configs and split manifests instead.
artifacts/**/gpu_telemetry.csv
artifacts/**/status.json
artifacts/**/per_user.csv
artifacts/**/validation_per_user.csv
artifacts/**/candidate_bank.json
artifacts/**/gamma.json
artifacts/**/splits/**/*.txt

# Large reproducible detail dumps. Keep their configs and aggregate summaries.
artifacts/**/predictions/
artifacts/**/candidate_scores.tsv
artifacts/**/feature_table.npz
artifacts/**/beams_w*.tsv
artifacts/**/fresh_beams*.tsv

# Phase-5 long-running CET session state; durable summaries are committed separately.
artifacts/phase5/cet_c2*/run.log
artifacts/phase5/cet_c2*/status.json

# Phase 13 experiment outputs
artifacts/phase13/explore/**/gram_logs/
artifacts/phase13/explore/**/mlp/*.pt
artifacts/phase13/explore/**/gpu_lease.json
artifacts/phase13/explore/**/metrics_cold_warm.json
artifacts/phase13/explore/**/*.jsonl
artifacts/phase13/llm_cache.db
artifacts/phase13/explore/**/mlp/training_history.json
artifacts/phase13/explore/**/mlp/vocab.json
artifacts/phase13/explore/**/training_history.json
artifacts/phase13/explore/**/vocab.json
artifacts/phase13/explore/**/llm_priors_status.json
artifacts/phase13/explore/**/gram_logs/**/config.json
artifacts/phase13/explore/**/*.log

# Phase 14 local model/data payloads and per-example outputs. Keep compact
# configs, provenance, aggregate summaries and synthesis files in Git.
artifacts/phase14/**/*.jsonl
artifacts/phase14/m2/pretrained/
artifacts/phase14/m2/pseudo_cold_audit_toys/
artifacts/phase14/m2/pseudo_cold_screen_toys_pipeline_smoke*/
artifacts/phase14/m2/pseudo_cold_screen_toys_shape_smoke/

# Phase 13 local resource orchestration and failed-launch diagnostics.
artifacts/phase13/explore/**/.resource_transition_started
artifacts/phase13/explore/**/preexisting_gpu_pids.txt
artifacts/phase13/explore/**/resource_watchdog_status.json
artifacts/phase13/explore/**/test_access.json
artifacts/phase13/explore/**/status.*.json
artifacts/phase13/explore/**/recompute_output.txt
