    "refresh": "static_once_before_training",
    "test_data_allowed": false
  },
  "margin": {
    "base": 0.1,
    "prefix_depth_cap": 3,
    "prefix_weight": "1 + min(prefix_depth, 3) / 3",
    "tail_weight": "1 + min(1, max(0, log((median_positive_frequency + 1) / (positive_frequency + 1))))",
    "joint": "base_margin * prefix_weight * tail_weight",
    "maximum": 0.4
  },
  "loss": {
    "ranking": "mean softplus(margin + negative_score - positive_score)",
    "lambda": 0.1,
    "total": "token_cross_entropy + lambda * ranking_loss"
